# Network Port Configuration
PORT=20130
DASHBOARD_PORT=20130
API_PORT=20131
LIVE_WS_PORT=20132

# Public URL (Change this to your Ngrok or Tailscale URL if needed)
PUBLIC_URL=http://localhost:20130

# Security (Change every value before starting)
INITIAL_PASSWORD=replace-with-a-strong-dashboard-password
JWT_SECRET=replace-with-a-long-random-jwt-secret
API_KEY_SECRET=replace-with-a-long-random-api-key-secret
MACHINE_ID_SALT=replace-with-a-long-random-machine-id-salt
