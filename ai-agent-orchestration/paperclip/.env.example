# ============================================================
# Paperclip - AI Agent Control Plane
# Environment Configuration
# ============================================================

# ── LLM Provider Keys (tuỳ chọn) ──
# Có thể để trống và kết nối tài khoản AI trong UI → Connectors.
# Dùng gói Claude Subscription (Pro / Max) thì ĐỂ TRỐNG ANTHROPIC_API_KEY.
# Lấy từ: https://platform.openai.com/api-keys
OPENAI_API_KEY="sk-..."

# Lấy từ: https://console.anthropic.com/settings/keys
ANTHROPIC_API_KEY="sk-ant-..."

# ── Deployment Mode ──
# "authenticated"  = yêu cầu đăng nhập (production)
# "local_trusted"  = bỏ qua auth (chỉ dùng local dev)
PAPERCLIP_DEPLOYMENT_MODE="authenticated"

# "private" = chỉ truy cập nội bộ
# "public"  = mở ra internet (cần auth)
PAPERCLIP_DEPLOYMENT_EXPOSURE="private"

# ── Security Secrets ──
# Tạo bằng lệnh: openssl rand -hex 32
# Hoặc trên PowerShell: [System.Convert]::ToHexString([System.Security.Cryptography.RandomNumberGenerator]::GetBytes(32)).ToLower()
BETTER_AUTH_SECRET="THAY_BANG_RANDOM_HEX_32_BYTES"
PAPERCLIP_TOOL_ACTION_SIGNING_SECRET="THAY_BANG_RANDOM_HEX_32_BYTES"

# ── Public URL ──
# URL mà Paperclip sẽ accessible (dùng cho webhook callbacks)
PAPERCLIP_PUBLIC_URL="http://localhost:3100"

# ── Port ──
PAPERCLIP_PORT=3100

# Thư mục data (bind mount). Trên WSL phải nằm trong ổ Linux, không dùng /mnt/<ổ> vì NTFS không hỗ trợ chmod 0700
# run.sh --setup tự đặt thành $HOME/paperclip-data
PAPERCLIP_DATA_DIR=/home/<user>/paperclip-data

# UID/GID user trong container = user của bạn trên host (`id -u` / `id -g`), để data dir vẫn thuộc về bạn.
# run.sh tự đặt / cập nhật theo user hiện tại.
USER_UID=1000
USER_GID=1000
